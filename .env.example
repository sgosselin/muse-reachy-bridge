# Copy to .env and fill in (or run ./scripts/setup.sh to generate it).
# NEVER commit .env — it holds secrets.

# Reachy Mini daemon base URL (setup.sh auto-probes; leave empty to probe at startup)
BRIDGE_MINI_URL=http://reachy-mini.local:8000/api
# Full-size Reachy host for the classic gRPC SDK (only used if no Mini found)
#BRIDGE_REACHY_HOST=
# Fake robot for testing the API/panel/auth with no hardware
#BRIDGE_MOCK=1

BRIDGE_PORT=8765

# Human panel token (browser/phone UI). The AGENT api uses Ed25519
# signatures, not this token — see keys/ and docs/ARCHITECTURE.md.
BRIDGE_PANEL_TOKEN=change-me-generate-with-openssl-rand-hex-16

BRIDGE_CLIENTS_DIR=clients
BRIDGE_AUDIT_LOG=audit.log
# Seconds a signed request stays valid (replay window)
BRIDGE_AUTH_WINDOW=120
